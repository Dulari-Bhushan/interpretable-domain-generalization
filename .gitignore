# Raw downloaded datasets (large, publicly redistributable from their original sources —
# see external/LanCE/README.md and planning/ for exact download links/sizes)
external/LanCE/data/CUB/CUB_200_2011.tgz
external/LanCE/data/CUB/CUB_200_2011/
external/LanCE/data/CUB/CUB-200-Painting.zip
external/LanCE/data/CUB/CUB-200-Painting/

# Model checkpoints (large, regenerable by rerunning training — see logs for the numbers they produced)
external/LanCE/*.pth
external/LanCE/best_*.pth
external/LanCE/checkpoints/

# Cached CLIP embeddings (large, trivially regenerable via cache_utils.py)
external/LanCE/embeddings_cache/

# Generic/overwritten-per-run log files - we redirect real run output to
# distinctly-named logs_*.log files instead, which ARE committed
external/LanCE/training.log
external/LanCE/training_cached.log
external/LanCE/domain_il.log

# Raw downloaded PACS dataset (large, manually obtained - see planning/ for source).
# The generated split manifests (pacs_classes.txt, pacs_<domain>_{train,test}.txt)
# are small path+label text files, kept and committed like CUB's cub_train.txt/cub_test.txt.
external/LanCE/data/PACS/pacs_raw/

# Raw downloaded Office-Home dataset (large, manually obtained - see planning/ for
# source). Generated split manifests (office_home_*.txt) are small and committed,
# same convention as PACS above.
external/LanCE/data/OfficeHome/office_home_raw/

# Raw EuroSAT dataset (large, auto-downloaded via torchvision.datasets.EuroSAT -
# no manual step needed, unlike PACS/Office-Home, but still large/regenerable).
external/LanCE/data/EuroSAT_raw/

# Generic log files for the Office-Home / EuroSAT scripts (same convention as above)
external/LanCE/domain_il_officehome.log

# Raw GenImage/Midjourney images (large, manually obtained - see planning/ and
# results/phase_f4_genimage_alignment.md for source and download caveats).
# imagenet_class_index.json is small reference data and is committed.
external/LanCE/data/GenImage/genimage_raw/

# Python artifacts
__pycache__/
*.pyc
.DS_Store

# wandb local run cache (we run with WANDB_MODE=offline / no --wandb flag)
external/LanCE/wandb/
